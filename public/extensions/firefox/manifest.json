{
  "manifest_version": 2,
  "name": "Porsuk Read (Firefox)",
  "version": "1.1.0",
  "description": "Açık sekmeyi Porsuk'ta temiz okuma modunda açar.",
  "permissions": ["contextMenus", "tabs", "storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "16": "favicon.ico",
    "32": "favicon.ico",
    "48": "favicon.ico",
    "96": "favicon.ico"
  },
  "browser_action": {
    "default_title": "Porsuk ile Oku",
    "default_icon": {
      "16": "favicon.ico",
      "32": "favicon.ico"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "applications": {
    "gecko": {
      "id": "porsuk-read@porsuk.app",
      "strict_min_version": "109.0"
    }
  }
}
