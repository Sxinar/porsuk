{
  "manifest_version": 3,
  "name": "Porsuk Read (Chrome)",
  "version": "1.1.0",
  "description": "Açık sekmeyi Porsuk'ta temiz okuma modunda açar.",
  "permissions": ["contextMenus", "tabs", "storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "favicon.ico",
    "32": "favicon.ico",
    "48": "favicon.ico",
    "128": "favicon.ico"
  },
  "action": {
    "default_title": "Porsuk ile Oku",
    "default_icon": {
      "16": "favicon.ico",
      "32": "favicon.ico"
    }
  },
  "options_page": "options.html"
}
